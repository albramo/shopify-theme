{
  "sections": {
    "main-product": {
      "type": "main-product-modal",
      "blocks": {
        "breadcrumb": {
          "type": "product-breadcrumb",
          "settings": {}
        },
        "vendor": {
          "type": "product-vendor",
          "settings": {}
        },
        "title": {
          "type": "product-title",
          "settings": {
            "text_wrap": "normal"
          }
        },
        "rating": {
          "type": "product-rating",
          "settings": {}
        },
        "price": {
          "type": "product-price",
          "settings": {}
        },
        "inventory": {
          "type": "product-inventory",
          "settings": {
            "inventory_style": "status_bar",
            "inventory_threshold": 10,
            "inventory_bar_max": 20,
            "show_inventory_quantity": "always",
            "show_inventory_transfer": true,
            "in_stock_color": "#109B36",
            "low_stock_color": "#109B36",
            "bar_background_color": "#E5E7EB"
          }
        },
        "description": {
          "type": "product-description",
          "settings": {}
        },
        "notice": {
          "type": "product-notice",
          "settings": {
            "link": "/collections/all"
          }
        },
        "coupon": {
          "type": "product-coupon",
          "settings": {},
          "blocks": {
            "offer": {
              "type": "_product-coupon-offer",
              "settings": {
                "value_label": "$80 OFF",
                "apply_text": "Save $80 on this order",
                "applied_text": "$80 discount applied",
                "code": "SAVE80"
              }
            }
          },
          "block_order": ["offer"]
        },
        "coupon_pack": {
          "type": "product-coupon-pack",
          "settings": {},
          "blocks": {
            "coupon_1": {
              "type": "_product-coupon-pack-item",
              "settings": {
                "code": "WELCOME50",
                "badge": "New user",
                "heading": "50% allowance",
                "condition": "Orders over US$0.01, max. US$4.00"
              }
            },
            "coupon_2": {
              "type": "_product-coupon-pack-item",
              "settings": {
                "code": "WELCOME6",
                "badge": "New user",
                "heading": "US$6.00 allowance",
                "condition": "Orders over US$40.00"
              }
            },
            "coupon_3": {
              "type": "_product-coupon-pack-item",
              "settings": {
                "code": "WELCOME12",
                "badge": "New user",
                "heading": "US$12.00 allowance",
                "condition": "Orders over US$100.00"
              }
            }
          },
          "block_order": ["coupon_1", "coupon_2", "coupon_3"]
        },
        "variants": {
          "type": "product-variant-picker",
          "settings": {}
        },
        "quantity": {
          "type": "product-quantity-selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "product-buy-buttons",
          "settings": {
            "show_quantity_selector": false
          }
        },
        "buyer_protection": {
          "type": "product-buyer-protection",
          "settings": {},

          "blocks": {
            "secure_payments": {
              "type": "_product-buyer-protection-item",
              "settings": {
                "icon": "return",
                "heading": "After Sales Assurance",
                "text": "Support is available after your order has been delivered."
              }
            },
            "money_back": {
              "type": "_product-buyer-protection-item",
              "settings": {
                "icon": "lock",
                "heading": "Secure Payment",
                "text": "Payment information is encrypted and processed securely."
              }
            },
            "delivery_protection": {
              "type": "_product-buyer-protection-item",
              "settings": {
                "icon": "package",
                "heading": "Refund for No Delivery",
                "text": "Get support when an eligible order does not arrive."
              }
            }
          },
          "block_order": ["secure_payments", "money_back", "delivery_protection"]
        },
        "pickup": {
          "type": "product-pickup",
          "settings": {}
        },
        "share": {
          "type": "product-share",
          "settings": {
            "share_label": "Share",
            "show_help_desk": true,
            "help_label": "Need help?",
            "help_type": "drawer"
          },
          "blocks": {
            "shipping_content": {
              "type": "_product-help-content",
              "settings": {
                "icon": "rocket",
                "heading": "Shipping <em>information</em>",
                "text": "<p>Share delivery times, order processing details, and shipping policies.</p>",
                "highlighted_text": "half_text",
                "color_text": "#7C4A03",
                "color_background": "#FFF8E8",
                "color_highlight": "#FFD99A"
              }
            },
            "customer_support": {
              "type": "_product-help-item",
              "settings": {
                "icon": "email",
                "heading": "Customer support",
                "text": "<p>Send us a message and our team will help you.</p>",
                "link_label": "Email us",
                "link_type": "email"
              }
            },
            "contact_help": {
              "type": "_product-help-item",
              "settings": {
                "icon": "chat_bubble",
                "heading": "More ways to get help",
                "text": "<p>Find answers, delivery information, and store policies.</p>",
                "link_label": "Contact us",
                "link_type": "url"
              }
            }
          },
          "block_order": [
            "shipping_content",
            "customer_support",
            "contact_help"
          ]
        },
        "details": {
          "type": "product-accordion",
          "settings": {
            "heading": "Shipping and returns"
          }
        }
      },
      "block_order": [
        "breadcrumb",
        "vendor",
        "title",
        "rating",
        "price",
        "inventory",
        "description",
        "notice",
        "coupon",
        "coupon_pack",
        "variants",
        "quantity",
        "buy_buttons",
        "buyer_protection",
        "pickup",
        "share",
        "details"
      ],
      "settings": {
        "layout_style": "clean",
        "media_position": "left",
        "media_size": 50,
        "desktop_gap": 0,
        "mobile_gap": 20,
        "block_gap": 16,
        "enable_sticky_info": false,
        "gallery_layout": "thumbnail",
        "thumbnail_position": "below",
        "image_ratio": "adapt_first",
        "image_zoom": "lightbox",
        "hide_variants": false,
        "enable_video_autoplay": false,
        "enable_video_looping": false,
        "mobile_media_position": "first",
        "mobile_layout": "full_width",
        "image_ratio_mobile": "adapt_first",
        "mobile_thumbnail": false,
        "color_text": "#1C1C1C",
        "color_background": "#FFFFFF",
        "panel_background": "#F4F2EE",
        "media_background": "#F7F7F5",
        "panel_radius": 0,
        "content_width": "full",
        "custom_content_width": 100,
        "divider": false,
        "rounded": false,
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  },
  "order": [
    "main-product"
  ]
}
