{% doc %}
  Renders a consistent outline icon for a product feature capsule.

  @param {string} icon - Feature icon name.
  @param {string} [class] - Optional CSS class.
{% enddoc %}

{%- liquid
  assign icon_name = icon | default: 'feature' | handleize
  assign icon_class = 'feature-capsule-icon'
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif
-%}

{%- case icon_name -%}
  {%- when 'speed', 'gear', 'gears', 'transmission', '5-speed', '5speed' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9.4 3.2 10 1.8h4l.6 1.4 1.7.7 1.4-.6 2.9 2.9-.6 1.4.7 1.7 1.4.6v4l-1.4.6-.7 1.7.6 1.4-2.9 2.9-1.4-.6-1.7.7-.6 1.4h-4l-.6-1.4-1.7-.7-1.4.6-2.9-2.9.6-1.4-.7-1.7-1.4-.6v-4l1.4-.6.7-1.7-.6-1.4 2.9-2.9 1.4.6 1.7-.7Z"/><circle cx="12" cy="12" r="3.2"/></svg>
  {%- when '4wd', 'awd', 'drivetrain', 'drive-train' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="3" width="5" height="4" rx="1"/><rect x="17" y="3" width="5" height="4" rx="1"/><rect x="2" y="17" width="5" height="4" rx="1"/><rect x="17" y="17" width="5" height="4" rx="1"/><path d="M4.5 7v10M19.5 7v10M7 5h10M7 19h10M9 9l6 6M15 9l-6 6"/></svg>
  {%- when 'ws', 'wheelbase', 'axle' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="5" cy="12" r="2.5"/><circle cx="19" cy="12" r="2.5"/><path d="M7.5 12h9M9 8v8M15 8v8M7 6h10M7 18h10"/></svg>
  {%- when 'brushless', 'motor', 'engine' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="6" width="12" height="12" rx="2"/><path d="M2 10v4M17 9h3l2 2v2l-2 2h-3M8 3v3M12 3v3M8 18v3M12 18v3M9 10h4v4H9z"/></svg>
  {%- when 'drag-brake', 'brake', 'disc-brake' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="12" r="8"/><circle cx="11" cy="12" r="3"/><path d="M17 6.5h3v11h-3M11 4v2M11 18v2M3 12h2"/></svg>
  {%- when 'fdc', 'differential', 'diff' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 18h4l3-3M21 6h-4l-3 3M9 7l8 8M7 9l8 8"/><circle cx="7" cy="7" r="2"/><circle cx="17" cy="17" r="2"/></svg>
  {%- when 'rtr', 'ready-to-run', 'box', 'package' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m4 7 8-4 8 4-8 4-8-4Z"/><path d="M4 7v10l8 4 8-4V7M12 11v10M8 5l8 4"/></svg>
  {%- when 'battery', 'lipo' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="6" width="17" height="12" rx="2"/><path d="M20 10h2v4h-2M11 9l-2 4h3l-2 3"/></svg>
  {%- when 'waterproof', 'water-resistant', 'ipx' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2s7 7.2 7 12a7 7 0 0 1-14 0C5 9.2 12 2 12 2Z"/><path d="M8.5 15.5c1.2 1.8 3.5 2.3 5.3 1.1"/></svg>
  {%- when 'scale', 'size' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 7V4h3M17 4h3v3M20 17v3h-3M7 20H4v-3M8 12h8M9.5 10.5 8 12l1.5 1.5M14.5 10.5 16 12l-1.5 1.5"/></svg>
  {%- when 'esc', 'controller', 'control' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 9h8M8 13h5M8 16h2M2 9h2M20 9h2M2 15h2M20 15h2"/></svg>
  {%- when 'servo' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="7" width="14" height="12" rx="2"/><path d="M9 7V4h6v3M8 12h8M12 9v6M3 11h2M19 11h2"/></svg>
  {%- when 'lights', 'light', 'led' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 18h6M10 21h4M8.5 15.5a7 7 0 1 1 7 0c-.9.7-1.5 1.4-1.5 2.5h-4c0-1.1-.6-1.8-1.5-2.5Z"/><path d="M12 5v3M8.5 9.5l2 2M15.5 9.5l-2 2"/></svg>
  {%- when 'metal', 'metal-parts', 'material' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m12 2 8.5 5v10L12 22l-8.5-5V7L12 2Z"/><path d="m3.5 7 8.5 5 8.5-5M12 12v10M8 4.4l8.5 5"/></svg>
  {%- else -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3.5 14.2 8l4.8.7-3.5 3.4.8 4.8-4.3-2.3-4.3 2.3.8-4.8L5 8.7 9.8 8 12 3.5Z"/></svg>
{%- endcase -%}
