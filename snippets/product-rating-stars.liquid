{%- comment -%}
  Renders a traditional five-star rating with partial-fill support.

  Accepts:
  - rating_value: {Number} Current rating value.
  - rating_max: {Number} Maximum rating value.
  - rating_count: {Number} Number of reviews.
  - display_mode: {String} Set to "count" to show the review count instead of the rating value.
{%- endcomment -%}

{%- liquid
  assign normalized_rating_max = rating_max | default: 5
  assign normalized_rating_value = rating_value | default: 0
  assign rating_percent = normalized_rating_value | times: 100.0 | divided_by: normalized_rating_max | at_least: 0 | at_most: 100
-%}

<div class="rating product-card__rating flex items-center gap-2 md:gap-1d5 w-full pointer-events-none" title="{{ 'general.accessibility.star_reviews_count' | t: count: rating_count | escape }}">
  <span
    class="product-card__rating-stars"
    role="img"
    aria-label="{{ 'general.accessibility.star_reviews_info' | t: rating_value: normalized_rating_value, rating_max: normalized_rating_max | escape }}"
    style="--rating-percent: {{ rating_percent }}%;"
  >
    <span class="product-card__rating-track" aria-hidden="true">
      {%- for i in (1..5) -%}
        {%- render 'icon', icon: 'star', size: 'xs' -%}
      {%- endfor -%}
    </span>
    <span class="product-card__rating-fill" aria-hidden="true">
      <span class="product-card__rating-fill-inner">
        {%- for i in (1..5) -%}
          {%- render 'icon', icon: 'star', size: 'xs' -%}
        {%- endfor -%}
      </span>
    </span>
  </span>
  <span class="product-card__rating-value">
    {%- liquid
      if display_mode == 'count'
        echo 'general.accessibility.star_reviews_count' | t: count: rating_count
      else
        echo normalized_rating_value
      endif
    -%}
  </span>
</div>
