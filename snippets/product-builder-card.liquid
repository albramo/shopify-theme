{% doc %}
  Renders a selectable product card for the Build your set section.

  @param {product} product - Product resource.
  @param {section} section - Parent section.
  @param {block} block - Product builder step block.
{% enddoc %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign card_image = current_variant.featured_image | default: product.featured_image
  assign card_image_alt = card_image.alt | default: product.title
  assign card_id = 'BuilderCard-' | append: section.id | append: '-' | append: block.id | append: '-' | append: product.id
  assign has_multiple_variants = true
  if product.has_only_default_variant
    assign has_multiple_variants = false
  endif
  assign card_available = current_variant.available
-%}

<article
  id="{{ card_id }}"
  class="ekko-builder-card"
  data-builder-card
  data-product-id="{{ product.id }}"
  data-product-title="{{ product.title | escape }}"
  data-product-url="{{ product.url | escape }}"
  data-variant-id="{{ current_variant.id }}"
  data-variant-title="{{ current_variant.title | escape }}"
  data-price="{{ current_variant.price }}"
  data-compare-price="{{ current_variant.compare_at_price | default: 0 }}"
  data-image-url="{% if card_image != blank %}{{ card_image | image_url: width: 240 }}{% endif %}"
  data-has-variants="{{ has_multiple_variants }}"
  data-available="{{ card_available }}"
>
  <input type="checkbox" value="{{ current_variant.id }}" data-builder-choice hidden>

  <div class="ekko-builder-card__media">
    <div class="ekko-builder-card__media-action">
      {%- if card_image != blank -%}
        {{- card_image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '240,360,480,640,800,1000,1200',
            sizes: '(max-width: 767px) 72vw, (max-width: 1199px) 36vw, 24vw',
            alt: card_image_alt,
            class: 'ekko-builder-card__image'
        -}}
      {%- else -%}
        {{- 'product-1' | placeholder_svg_tag: 'ekko-builder-card__placeholder' -}}
      {%- endif -%}

      {%- render 'product-badges',
        product: product,
        show_save_amount: true,
        save_type: 'label',
        show_sold_out: true,
        class: 'ekko-builder-card__badges'
      -%}

    </div>
  </div>

  <div class="ekko-builder-card__content">
    {%- if section.settings.show_vendor and product.vendor != blank -%}
      <p class="ekko-builder-card__vendor">{{ product.vendor | escape }}</p>
    {%- endif -%}

    <span class="ekko-builder-card__title">{{ product.title | escape }}</span>

    <p class="ekko-builder-card__variant" data-card-variant-title{% if product.has_only_default_variant %} hidden{% endif %}>
      {{- current_variant.title | escape -}}
    </p>

    <div class="ekko-builder-card__price" aria-live="polite">
      <span data-card-price>{{ current_variant.price | money }}</span>
      <s data-card-compare-price{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>
        {{- current_variant.compare_at_price | money -}}
      </s>
    </div>

    {%- if section.settings.show_swatches -%}
      <div class="ekko-builder-card__swatches" aria-hidden="true">
        {%- for option in product.options_with_values -%}
          {%- assign rendered_swatches = 0 -%}
          {%- for value in option.values limit: 6 -%}
            {%- if value.swatch.color != blank or value.swatch.image != blank -%}
              <span
                class="ekko-builder-card__swatch"
                style="{%- if value.swatch.image != blank -%}--builder-swatch: url({{ value.swatch.image | image_url: width: 48 }});{%- else -%}--builder-swatch: {{ value.swatch.color }};{%- endif -%}"
              ></span>
              {%- assign rendered_swatches = rendered_swatches | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if rendered_swatches > 0 -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if has_multiple_variants -%}
      <div class="ekko-builder-card__actions">
        <button
          type="button"
          class="ekko-builder-card__change"
          data-change-options
          data-label-choose="{{ 'sections.product_set_builder.choose_options' | t | escape }}"
          data-label-change="{{ 'sections.product_set_builder.change_options' | t | escape }}"
        >
          {{- 'sections.product_set_builder.choose_options' | t -}}
        </button>
      </div>
    {%- endif -%}
  </div>

  <button
    type="button"
    class="ekko-builder-card__toggle-card"
    data-card-action
    aria-pressed="false"
    aria-label="{% if has_multiple_variants %}{{ 'sections.product_set_builder.choose_options_for' | t: product: product.title | escape }}{% else %}{{ 'sections.product_set_builder.select_product' | t: product: product.title | escape }}{% endif %}"
    {% unless card_available %}disabled{% endunless %}
  >
    <span class="ekko-builder-card__check" aria-hidden="true">
      <svg viewBox="0 0 20 20" fill="none">
        <path d="m5 10.25 3.1 3.1L15.25 6.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </button>

  {%- unless product.has_only_default_variant -%}
    <script type="application/json" data-builder-product-json>
      {{- product | json -}}
    </script>
  {%- endunless -%}
</article>
