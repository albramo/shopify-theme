{% doc %}
  A copyable coupon entry rendered inside the Product coupon pack block.
{% enddoc %}

{%- liquid
  assign item_background = 'var(--coupon-pack-card-background)'
  assign item_color = 'var(--coupon-pack-card-color)'
  assign item_accent = 'var(--coupon-pack-accent)'

  if block.settings.background != blank and block.settings.background != 'rgba(0,0,0,0)'
    assign item_background = block.settings.background
  endif
  if block.settings.text_color != blank and block.settings.text_color != 'rgba(0,0,0,0)'
    assign item_color = block.settings.text_color
  endif
  if block.settings.accent_color != blank and block.settings.accent_color != 'rgba(0,0,0,0)'
    assign item_accent = block.settings.accent_color
  endif
-%}

<article
  class="ekko-coupon-pack-item__card"
  data-coupon-pack-item
  data-countries="{{ block.settings.country_codes | escape }}"
  data-expires-at="{{ block.settings.expiry_date | escape }}"
  style="
    --coupon-item-background: {{ item_background }};
    --coupon-item-color: {{ item_color }};
    --coupon-item-accent: {{ item_accent }};
  "
>
  <div class="ekko-coupon-pack-item__content">
    <div class="ekko-coupon-pack-item__meta">
      {%- if block.settings.category != blank -%}
        <span class="ekko-coupon-pack-item__category">{{ block.settings.category | escape }}</span>
      {%- endif -%}
      {%- if block.settings.badge != blank -%}
        <span class="ekko-coupon-pack-item__badge">{{ block.settings.badge | escape }}</span>
      {%- endif -%}
    </div>

    {%- assign offer_heading = block.settings.heading | default: block.settings.offer_label -%}
    {%- if offer_heading != blank -%}
      <p class="ekko-coupon-pack-item__offer">{{ offer_heading | escape }}</p>
    {%- endif -%}

    {%- if block.settings.condition != blank -%}
      <p class="ekko-coupon-pack-item__condition">{{ block.settings.condition | escape }}</p>
    {%- endif -%}

    {%- if block.settings.note != blank -%}
      <p class="ekko-coupon-pack-item__note">{{ block.settings.note | escape }}</p>
    {%- endif -%}

    {%- if block.settings.show_code and block.settings.code != blank -%}
      <span class="ekko-coupon-pack-item__code" aria-label="Coupon code {{ block.settings.code | escape }}">{{ block.settings.code | escape }}</span>
    {%- endif -%}

    {%- if block.settings.expiry_date != blank -%}
      <p class="ekko-coupon-pack-item__expiry">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="10" r="7.25" stroke="currentColor" stroke-width="1.5"/>
          <path d="M10 6.4v4l2.7 1.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>{{ block.settings.expiry_prefix | escape }} {{ block.settings.expiry_date | escape }}</span>
      </p>
    {%- endif -%}
  </div>

  <button
    class="ekko-coupon-pack-item__button"
    type="button"
    data-coupon-copy
    data-copy-code="{{ block.settings.code | escape }}"
    data-default-label="{{ block.settings.button_label | escape }}"
    data-copied-label="{{ block.settings.copied_label | escape }}"
    data-copy-again-label="{{ block.settings.copy_again_label | escape }}"
    data-expired-label="{{ block.settings.expired_label | escape }}"
    data-unavailable-label="{{ block.settings.unavailable_label | escape }}"
    data-error-label="{{ block.settings.error_message | escape }}"
    {% if block.settings.code == blank %}disabled{% endif %}
  >
    <span data-coupon-copy-text>{{ block.settings.button_label | escape }}</span>
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="m5.5 10.2 3 3 6-6.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
</article>

{% stylesheet %}
  .ekko-coupon-pack-item {
    display: block;
    min-width: 0;
    list-style: none;
  }

  .ekko-coupon-pack-item__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-width: 0;
    padding: 1rem;
    border-radius: .8rem;
    background: var(--coupon-item-background);
    color: var(--coupon-item-color);
  }

  .ekko-coupon-pack-item__content {
    display: grid;
    gap: .24rem;
    min-width: 0;
  }

  .ekko-coupon-pack-item__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    min-width: 0;
  }

  .ekko-coupon-pack-item__category {
    overflow: hidden;
    font-size: .72rem;
    line-height: 1.25;
    opacity: .68;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ekko-coupon-pack-item__badge {
    flex: 0 0 auto;
    max-width: 50%;
    overflow: hidden;
    padding: .18rem .4rem;
    border-radius: .3rem;
    background: var(--coupon-item-accent);
    color: #fff;
    font-size: .68rem;
    font-weight: 700;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ekko-coupon-pack-item__offer {
    display: -webkit-box;
    margin: .28rem 0 .05rem;
    overflow: hidden;
    color: var(--coupon-item-accent);
    font-size: clamp(1.25rem, 1.08rem + .65vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -.025em;
    line-height: 1.05;
    overflow-wrap: anywhere;
    text-wrap: balance;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .ekko-coupon-pack-item__condition,
  .ekko-coupon-pack-item__note,
  .ekko-coupon-pack-item__expiry {
    margin: 0;
    font-size: .76rem;
    line-height: 1.35;
  }

  .ekko-coupon-pack-item__condition {
    color: var(--coupon-item-accent);
    font-size: .78rem;
    font-weight: 650;
  }

  .ekko-coupon-pack-item__note {
    opacity: .66;
  }

  .ekko-coupon-pack-item__code {
    justify-self: start;
    margin-top: .25rem;
    padding: .22rem .45rem;
    border-radius: .35rem;
    background: rgb(255 255 255 / .66);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: .72rem;
    font-weight: 650;
    letter-spacing: .035em;
  }

  .ekko-coupon-pack-item__expiry {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    margin-top: .2rem;
    opacity: .78;
  }

  .ekko-coupon-pack-item__expiry svg {
    flex: 0 0 .9rem;
    width: .9rem;
    height: .9rem;
  }

  .ekko-coupon-pack-item__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .3rem;
    min-width: 4.75rem;
    min-height: 2.75rem;
    padding: .55rem .75rem;
    border: 0;
    border-radius: .5rem;
    background: var(--coupon-item-accent);
    color: #fff;
    font-size: .8rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    transition: filter 160ms ease, opacity 160ms ease;
  }

  .ekko-coupon-pack-item__button:hover:not(:disabled) {
    filter: brightness(.92);
  }

  .ekko-coupon-pack-item__button:focus-visible {
    outline: 2px solid var(--coupon-item-accent);
    outline-offset: 2px;
  }

  .ekko-coupon-pack-item__button svg {
    display: none;
    width: .95rem;
    height: .95rem;
  }

  .ekko-coupon-pack-item__button[data-copied='true'] svg {
    display: block;
  }

  .ekko-coupon-pack-item__button:disabled {
    cursor: not-allowed;
    opacity: .5;
  }

  .ekko-coupon-pack-item__card[data-expired='true'],
  .ekko-coupon-pack-item__card[data-unavailable='true'] {
    filter: saturate(.35);
  }

  @media screen and (max-width: 639px) {
    .ekko-coupon-pack-item__card {
      gap: .65rem;
      padding: .85rem;
    }

    .ekko-coupon-pack-item__button {
      min-width: 4.25rem;
      padding-inline: .55rem;
    }

    .ekko-coupon-pack-item__offer {
      font-size: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ekko-coupon-pack-item__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Coupon offer",
  "tag": "li",
  "class": "ekko-coupon-pack-item",
  "settings": [
    { "type": "header", "content": "Offer" },
    { "type": "text", "id": "heading", "label": "Offer title" },
    { "type": "text", "id": "category", "label": "Category", "default": "Selected categories" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "New user" },
    { "type": "text", "id": "condition", "label": "Condition", "default": "Orders over US$50.00" },
    { "type": "text", "id": "note", "label": "Additional information", "default": "Valid for 30 days after collection" },

    { "type": "header", "content": "Coupon code" },
    { "type": "text", "id": "code", "label": "Discount code", "default": "WELCOME10" },
    { "type": "checkbox", "id": "show_code", "label": "Show code on card", "default": false },

    { "type": "header", "content": "Availability" },
    { "type": "text", "id": "country_codes", "label": "Country codes", "info": "Optional comma-separated ISO codes, for example US, CA, GB." },
    { "type": "text", "id": "expiry_date", "label": "Expiry date", "info": "Optional. Use YYYY-MM-DD." },
    { "type": "text", "id": "expiry_prefix", "label": "Expiry label", "default": "Expires" },

    { "type": "header", "content": "Button messages" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get" },
    { "type": "text", "id": "copied_label", "label": "Copied label", "default": "Copied" },
    { "type": "text", "id": "copy_again_label", "label": "Copy again label", "default": "Copy again" },
    { "type": "text", "id": "expired_label", "label": "Expired label", "default": "Expired" },
    { "type": "text", "id": "unavailable_label", "label": "Unavailable label", "default": "Unavailable" },
    { "type": "text", "id": "error_message", "label": "Copy error message", "default": "Unable to copy the coupon code." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "color", "id": "accent_color", "label": "Accent" }
  ],
  "presets": [
    { "name": "Coupon offer", "settings": { "heading": "$10 allowance" } }
  ]
}
{% endschema %}
