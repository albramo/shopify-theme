{% doc %}
  Product price and optional tax/payment terms with save badge.
{% doc %}

{%- liquid
  assign product_item = section.settings.product | default: product
  assign product_id = product_item.id | default: section.id
  assign placeholder = false
  if product_item == blank
    assign placeholder = true
  endif
-%}

<div class="ekko-product-block product__price grid gap-3" style="--product-block-color: {{ block.settings.color }};">
  <div id="Price-{{ section.id }}-{{ product_id }}">
    {%- render 'product-price', product: product_item, placeholder: placeholder, use_variant: true, show_save_badge: block.settings.show_save_badge, class: 'flex flex-wrap items-center gap-3' -%}
  </div>

  {%- if block.settings.show_taxes_notice and product_item != blank -%}
    <div class="product__tax rte text-sm opacity-80">
      {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
        {{- 'products.product.include_taxes' | t -}}
        {{- 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url -}}
      {%- elsif cart.taxes_included -%}
        {{- 'products.product.include_taxes' | t -}}
      {%- elsif shop.shipping_policy.body != blank -%}
        {{- 'products.product.taxes_and_shipping_policy_html' | t: link: shop.shipping_policy.url -}}
      {%- else -%}
        {{- 'products.product.taxes_and_shipping_at_checkout' | t -}}
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if block.settings.show_payment_terms and product_item != blank -%}
    {%- assign installment_form_id = 'ProductFormInstallment-' | append: section.id | append: '-' | append: product_id -%}
    {%- form 'product', product_item, id: installment_form_id, class: 'installment caption-large' -%}
      <input type="hidden" name="id" value="{{ product_item.selected_or_first_available_variant.id }}">
      {{ form | payment_terms }}
    {%- endform -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product price",
  "settings": [
    { "type": "checkbox", "id": "show_save_badge", "label": "Show save amount badge", "default": true },
    { "type": "header", "content": "Additional information" },
    { "type": "checkbox", "id": "show_payment_terms", "label": "Show installment payment terms", "default": true },
    { "type": "checkbox", "id": "show_taxes_notice", "label": "Show tax and shipping notice", "default": true },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "color", "label": "Text color", "default": "#1C1C1C" }
  ],
  "presets": [{ "name": "Product price" }]
}
{% endschema %}
