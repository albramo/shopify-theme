{% doc %}
  Product variant picker using the theme's existing variant interaction.
{% enddoc %}

{%- liquid
  assign product_item = section.settings.product | default: product
  assign product_id = product_item.id | default: section.id
  assign product_form_id = 'ProductForm-' | append: section.id | append: '-' | append: product_id
-%}

{%- if product_item != blank -%}
  {%- render 'product-variant-picker',
    block: block,
    product: product_item,
    product_id: product_id,
    section_id: section.id,
    product_form_id: product_form_id,
    image_ratio: section.settings.image_ratio,
    image_ratio_mobile: section.settings.image_ratio_mobile,
    image_fill: settings.product_image_fill,
    show_shopify_attributes: false
  -%}
{%- else -%}
  <div class="ekko-product-block variant-picker grid gap-3">
    <span class="form__label">Option</span>
    <div class="ekko-product-showcase__placeholder-options" aria-hidden="true"><span>S</span><span>M</span><span>L</span></div>
  </div>
{%- endif -%}

{% stylesheet %}
  .ekko-variant-swatches {
    --ekko-color-swatch-size: 2.25rem;
    --ekko-image-swatch-size: 4rem;
    --ekko-swatch-selected-color: #171717;
  }

  .ekko-variant-swatches--small {
    --ekko-color-swatch-size: 2rem;
    --ekko-image-swatch-size: 3.5rem;
  }

  .ekko-variant-swatches--large {
    --ekko-color-swatch-size: 2.75rem;
    --ekko-image-swatch-size: 4.75rem;
  }

  .ekko-variant-swatches--color .ekko-variant-swatch {
    --swatch-size: var(--ekko-color-swatch-size);
  }

  .ekko-variant-swatches--color input:checked + .ekko-variant-swatch::after {
    box-shadow: 0 0 0 2px var(--ekko-swatch-selected-color);
  }

  .ekko-variant-swatches--color input:focus-visible + .ekko-variant-swatch {
    outline-color: var(--ekko-swatch-selected-color);
  }

  .ekko-variant-swatches--image .ekko-variant-swatch {
    --swatch-radius: .625rem;
    --swatch-offset: 0px;
    --swatch-size: var(--ekko-image-swatch-size);
    background-color: rgb(var(--color-placeholder));
    box-shadow: inset 0 0 0 1px rgb(var(--color-border) / .65);
    transform: translateY(0);
    transition:
      box-shadow var(--animation-short),
      opacity var(--animation-short),
      transform var(--animation-short);
  }

  .ekko-variant-swatches--circle .ekko-variant-swatch--color {
    --swatch-radius: 9999px;
  }

  .ekko-variant-swatches--rounded .ekko-variant-swatch--color {
    --swatch-radius: .45rem;
  }

  .ekko-variant-swatches--square .ekko-variant-swatch--color {
    --swatch-radius: 0;
  }

  .ekko-variant-swatches--image-fit-contain .ekko-variant-swatch.with-image {
    background-size: contain;
  }

  .ekko-variant-swatches--image-fit-cover .ekko-variant-swatch.with-image {
    background-size: cover;
  }

  .ekko-variant-swatches--image .ekko-variant-swatch::before {
    box-shadow: inset 0 0 0 1px rgb(var(--color-background) / .45);
    pointer-events: none;
  }

  .ekko-variant-swatches--image .ekko-variant-swatch::after {
    content: '\2713';
    display: grid;
    place-items: center;
    inset: .35rem .35rem auto auto;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 9999px;
    color: rgb(var(--color-background));
    background: var(--ekko-swatch-selected-color);
    box-shadow: 0 3px 10px rgb(var(--color-foreground) / .2);
    font-size: .72rem;
    font-weight: 700;
    line-height: 1;
    opacity: 0;
    transform: scale(.72);
    transform-origin: center;
    transition:
      opacity var(--animation-short),
      transform var(--animation-short);
    z-index: 1;
  }

  .ekko-variant-swatches--image input:checked + .ekko-variant-swatch {
    box-shadow:
      inset 0 0 0 2px var(--ekko-swatch-selected-color),
      0 8px 20px color-mix(in srgb, var(--ekko-swatch-selected-color) 18%, transparent);
    transform: translateY(-2px);
  }

  .ekko-variant-swatches--image input:checked + .ekko-variant-swatch::after {
    opacity: 1;
    transform: scale(1);
  }

  .ekko-variant-swatches--image input:focus-visible + .ekko-variant-swatch {
    outline: 2px solid var(--ekko-swatch-selected-color);
    outline-offset: 3px;
  }

  .ekko-variant-swatches--image input:is(:disabled, .disabled) + .ekko-variant-swatch {
    box-shadow: inset 0 0 0 1px rgb(var(--color-border) / .5);
    filter: grayscale(.35);
    opacity: .48;
    transform: none;
  }

  .ekko-variant-swatches--image input:is(:disabled, .disabled) + .ekko-variant-swatch::after {
    display: none;
  }

  @media screen and (pointer: fine) {
    .ekko-variant-swatches--image input:not(:disabled, .disabled) + .ekko-variant-swatch:hover {
      box-shadow:
        inset 0 0 0 1px rgb(var(--color-foreground) / .55),
        0 7px 18px rgb(var(--color-foreground) / .1);
      transform: translateY(-2px);
    }

    .ekko-variant-swatches--image input:checked + .ekko-variant-swatch:hover {
      box-shadow:
        inset 0 0 0 2px var(--ekko-swatch-selected-color),
        0 9px 22px color-mix(in srgb, var(--ekko-swatch-selected-color) 20%, transparent);
    }
  }

  @media screen and (max-width: 749px) {
    .ekko-variant-swatches--image {
      flex-wrap: nowrap;
      width: 100%;
      padding: .25rem;
      margin: -.25rem;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
    }

    .ekko-variant-swatches--image::-webkit-scrollbar {
      display: none;
    }

    .ekko-variant-swatches--image > li {
      flex: 0 0 auto;
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Variant picker",
  "settings": [
    { "type": "select", "id": "picker_type", "label": "Picker type", "options": [{ "value": "button", "label": "Buttons" }, { "value": "dropdown", "label": "Dropdown" }], "default": "button" },
    { "type": "checkbox", "id": "show_variant_labels", "label": "Show variant labels", "default": true },
    { "type": "header", "content": "Swatches", "visible_if": "{{ block.settings.picker_type == 'button' }}" },
    { "type": "checkbox", "id": "enable_color_swatches", "label": "Enable swatches", "default": true, "visible_if": "{{ block.settings.picker_type == 'button' }}" },
    { "type": "textarea", "id": "color_swatch_options", "label": "Color swatch options", "info": "Enter exact option names separated by commas or new lines, for example Color or Finish.", "default": "Color\nColour", "visible_if": "{{ block.settings.picker_type == 'button' and block.settings.enable_color_swatches }}" },
    { "type": "textarea", "id": "image_swatch_options", "label": "Variant image swatch options", "info": "Enter exact option names separated by commas or new lines, for example Style or Pattern.", "visible_if": "{{ block.settings.picker_type == 'button' and block.settings.enable_color_swatches }}" },
    { "type": "select", "id": "swatch_shape", "label": "Color swatch shape", "options": [{ "value": "circle", "label": "Circle" }, { "value": "rounded", "label": "Rounded square" }, { "value": "square", "label": "Square" }], "default": "rounded", "visible_if": "{{ block.settings.picker_type == 'button' and block.settings.enable_color_swatches }}" },
    { "type": "select", "id": "swatch_size", "label": "Swatch size", "options": [{ "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "medium", "visible_if": "{{ block.settings.picker_type == 'button' and block.settings.enable_color_swatches }}" },
    { "type": "select", "id": "image_swatch_fit", "label": "Variant image fit", "options": [{ "value": "contain", "label": "Contain" }, { "value": "cover", "label": "Cover" }], "default": "contain", "visible_if": "{{ block.settings.picker_type == 'button' and block.settings.enable_color_swatches }}" },
    { "type": "color", "id": "selected_swatch_color", "label": "Selected swatch color", "default": "#171717", "visible_if": "{{ block.settings.picker_type == 'button' and block.settings.enable_color_swatches }}" },
    { "type": "page", "id": "size_chart", "label": "Size chart page" }
  ],
  "presets": [{ "name": "Variant picker" }]
}
{% endschema %}
